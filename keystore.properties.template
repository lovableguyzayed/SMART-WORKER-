# Copy this file to `keystore.properties` (same directory, repo root) and fill in
# your real values. `keystore.properties` and *.jks are git-ignored — NEVER commit them.
#
# Generate the keystore once with:
#   keytool -genkeypair -v -keystore release.jks -alias smartworker \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the repository root.
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=smartworker
keyPassword=CHANGE_ME
